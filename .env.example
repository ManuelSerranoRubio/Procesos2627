# Copia este archivo a .env y rellena los valores.
# NUNCA subas .env ni credenciales reales al repositorio.

NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Secreto para firmar la cookie de sesión (obligatorio)
SESSION_SECRET=

# MongoDB Atlas (obligatorio en producción)
MONGODB_URI=
MONGODB_DB=procesos

# Google OAuth 2.0 (opcional; si falta, el botón se oculta)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Correo transaccional SMTP (obligatorio en producción para confirmar cuentas)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Sólo para el script de creación del primer administrador
ADMIN_EMAIL=
ADMIN_PASSWORD=
